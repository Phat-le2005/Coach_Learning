APP_NAME=EduMS
APP_ENV=development
DEBUG=true

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=edums
DATABASE_USER=postgres
DATABASE_PASSWORD=

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep the real key in backend/.env only. Empty key disables authentication (503).
JWT_SECRET_KEY=
JWT_ISSUER=edums
JWT_AUDIENCE=edums-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Development seed only. Use at least 12 characters; never expose it to the frontend.
SEED_DEMO_PASSWORD=

# AI Layer Configuration (No local models)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL_FAST=gemini-2.5-flash
AI_MODEL_STANDARD=gemini-2.5-standard
AI_MODEL_REASONING=gemini-2.5-pro
AI_EMBEDDING_MODEL=text-embedding-004
AI_TIMEOUT_SECONDS=30.0
AI_MAX_RETRIES=2

