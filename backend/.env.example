APP_NAME=EduMS
APP_ENV=development
EDUMS_DEBUG=true

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=edums
DATABASE_USER=postgres
DATABASE_PASSWORD=

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
# Additional exact frontend origins for same-account live ink over LAN (single worker).
LIVE_INK_ORIGINS=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep the real key in backend/.env only. Empty key disables authentication (503).
JWT_SECRET_KEY=
JWT_ISSUER=edums
JWT_AUDIENCE=edums-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Development seed only. Use at least 12 characters; never expose it to the frontend.
SEED_DEMO_PASSWORD=

# AI Layer Configuration (server-side Gemini API; set key only in backend/.env)
# Keep mock only for tests; use gemini for real answer-grounded review.
AI_PROVIDER=gemini
AI_API_KEY=
# GEMINI_API_KEY is also accepted. OCR and grading use the same resolved key.
AI_MODEL_FAST=gemini-3.6-flash
AI_MODEL_STANDARD=gemini-3.6-flash
AI_MODEL_REASONING=gemini-3.6-flash
AI_EMBEDDING_MODEL=text-embedding-004
AI_TIMEOUT_SECONDS=30.0
AI_MAX_RETRIES=2

# Shared Gemini pool: explicit pool wins over all legacy key variables.
# Configure aliases for actual Google projects; keys in one project share quota.
# Keep real secrets in backend/.env. Never use example values as real project IDs.
# GEMINI_KEY_A=your-private-key
# GEMINI_KEY_B=your-other-private-key
# GEMINI_KEY_POOL='[{"id":"A","project":"projectA","env":"GEMINI_KEY_A"},{"id":"B","project":"projectB","env":"GEMINI_KEY_B"}]'
# Simpler legacy list (unknown project group, conservative shared-quota handling):
# AI_API_KEYS=key_A,key_B
# Without a pool/list, existing AI_API_KEY / GEMINI_API_KEY still work.

# Candidate order; uncomment only after authorized preflight confirms capabilities.
# GEMINI_MODEL_PRIORITY=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite
# Empty priority preserves each caller's current primary model and legacy fallbacks.
GEMINI_MODEL_PRIORITY=
# Grade only on models explicitly accepted after quality review. Empty = current
# grading model only. Lite is never implicitly approved for official review.
GEMINI_GRADING_MODELS=
GEMINI_FAILOVER_MAX_ATTEMPTS=18
GEMINI_ATTEMPT_TIMEOUT_SECONDS=8
GEMINI_TUTOR_ATTEMPT_TIMEOUT_SECONDS=6
GEMINI_OCR_ATTEMPT_TIMEOUT_SECONDS=8
GEMINI_REVIEW_ATTEMPT_TIMEOUT_SECONDS=25
GEMINI_OCR_TOTAL_TIMEOUT_SECONDS=24
GEMINI_MAX_INFLIGHT_PER_PROJECT_MODEL=4
GEMINI_COOLDOWN_SECONDS=15
GEMINI_QUOTA_COOLDOWN_SECONDS=60
GEMINI_AUTH_COOLDOWN_SECONDS=600
# Recommended for demo after --live --probe has generated a fresh manifest.
# Path relative to backend working directory. No automatic startup API calls.
# GEMINI_CAPABILITIES_FILE=../.tmp/gemini/capabilities.json
GEMINI_REQUIRE_VERIFIED_MODELS=false


# Classroom-scoped teacher uploads; file bytes are never stored in PostgreSQL.
TEACHER_MATERIAL_STORAGE_DIR=var/teacher_materials
TEACHER_MATERIAL_MAX_BYTES=26214400

# Exercise PDF OCR uses the separately provisioned tools/pdf_metadata runtime.
# Defaults live under the checkout's ignored .tmp/. No model is auto-downloaded.
# Point this at your existing runtime when it was provisioned elsewhere.
# TEACHER_PDF_RUNTIME_DIR=C:/CoachLearningPdf/pdf-pipeline-runtime
# TEACHER_PDF_IMPORT_DIR=D:/your-checkout/.tmp/teacher-pdf-imports
TEACHER_PDF_DEVICE=CPU
TEACHER_PDF_PORT=8790

# OCR handwriting recognition (server-side only).
# Gemini uses the same AI_API_KEY (or GEMINI_API_KEY) as grading.
# "local_pix2tex" runs on this machine, no API billing or student ink upload.
# "mock" is for local demonstration and tests, never production.
MATH_OCR_PROVIDER=gemini
GEMINI_OCR_MODEL=gemini-3.8-flash
# Optional pre-provisioned RapidLaTeXOCR checkpoint directory (four model files).
# Leave unset to use rapid_latex_ocr/models in the isolated Python environment.
# MATH_OCR_MODEL_DIR=var/ocr_models
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
MATH_OCR_TIMEOUT_SECONDS=12

# One bounded request for a complete step review (no automatic review retries).
AI_STEP_REVIEW_TIMEOUT_SECONDS=90
