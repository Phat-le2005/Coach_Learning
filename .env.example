# Reference template only. The backend reads backend/.env;
# Next.js reads frontend/.env.local. Copy the examples in those directories.
APP_NAME=EduMS
APP_ENV=development
DEBUG=true
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=edums
DATABASE_USER=postgres
DATABASE_PASSWORD=
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Backend only; generate a random key, never commit it or expose it to Next.js.
JWT_SECRET_KEY=
JWT_ISSUER=edums
JWT_AUDIENCE=edums-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Backend development seed only; at least 12 characters.
SEED_DEMO_PASSWORD=
