{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-table-candidate/v1",
  "title": "Unapproved source-grounded sign or variation table",
  "type": "object",
  "required": ["schema_version", "algorithm", "axis", "function_label", "boundaries", "intervals", "point_values", "status", "academic_review", "grading_support", "publishable"],
  "properties": {
    "schema_version": {"enum": ["sign-table-candidate/v1", "variation-table-candidate/v1"]},
    "algorithm": {"type": "string", "minLength": 1},
    "axis": {"type": "string", "pattern": "^[A-Za-z]$"},
    "function_label": {"type": "string", "pattern": "^[A-Za-z]$"},
    "boundaries": {
      "type": "array", "minItems": 2, "maxItems": 8,
      "items": {"type": "object", "required": ["value", "bbox_pixel", "x_pixel"], "properties": {
        "value": {"$ref": "#/$defs/endpoint"}, "bbox_pixel": {"$ref": "#/$defs/bbox"}, "x_pixel": {"type": "number"}
      }}
    },
    "intervals": {
      "type": "array", "minItems": 1, "maxItems": 7,
      "items": {"type": "object", "required": ["left", "right"], "anyOf": [{"required": ["source_sign"]}, {"required": ["direction"]}], "properties": {
        "left": {"$ref": "#/$defs/endpoint"}, "right": {"$ref": "#/$defs/endpoint"},
        "source_sign": {"enum": ["+", "-"]}, "direction": {"enum": ["INCREASING", "DECREASING"]}
      }}
    },
    "point_values": {"type": "array", "items": {"type": "object", "required": ["at", "value"], "properties": {
      "at": {"$ref": "#/$defs/endpoint"}, "value": {"const": "0"}
    }}},
    "function_values": {"type": "array", "items": {"type": "object", "required": ["at", "value"], "properties": {
      "at": {"$ref": "#/$defs/endpoint"}, "value": {"$ref": "#/$defs/endpoint"}
    }}},
    "status": {"const": "RASTER_AND_OCR_CANDIDATE_NOT_VISUALLY_VERIFIED"},
    "academic_review": {"const": "PENDING"},
    "grading_support": {"const": "NOT_ASSESSED"},
    "publishable": {"const": false}
  },
  "$defs": {
    "endpoint": {"type": "string", "minLength": 1, "maxLength": 256},
    "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0}}
  }
}
