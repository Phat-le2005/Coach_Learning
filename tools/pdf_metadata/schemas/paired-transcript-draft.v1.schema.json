{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-preserving paired transcript draft, not grading content",
  "type": "object",
  "required": ["schema_version", "question_id", "collection_number", "source", "pipeline_identity", "checkpoint_identity", "parts", "formula_candidates", "issues", "academic_review", "grading_support", "publishable"],
  "properties": {
    "schema_version": {"const": "paired-transcript-draft/v1"},
    "question_id": {"type": "string", "minLength": 1},
    "collection_number": {"type": "integer", "minimum": 1},
    "source": {"type": "object", "required": ["name", "sha256"], "properties": {"name": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "pipeline_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checkpoint_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parts": {"type": "object", "required": ["question", "solution", "answer"], "additionalProperties": false, "properties": {"question": {"$ref": "#/$defs/part"}, "solution": {"$ref": "#/$defs/part"}, "answer": {"$ref": "#/$defs/part"}}},
    "formula_candidates": {"type": "array", "items": {"type": "object", "required": ["formula_id", "role", "page_number", "source_glyph_keys", "asset_path", "asset_sha256", "latex_candidate", "display_latex", "syntax", "method"], "properties": {"formula_id": {"type": "string"}, "role": {"enum": ["question", "solution", "answer"]}, "page_number": {"type": "integer", "minimum": 1}, "source_glyph_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "asset_path": {"type": "string", "pattern": "^assets/"}, "asset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "latex_candidate": {"type": "string"}, "display_latex": {"type": ["string", "null"]}, "syntax": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["PASS", "FAIL"]}}}, "method": {"enum": ["NATIVE_SUPPORTED_GEOMETRY_DRAFT", "LOCAL_FORMULA_IMAGE_READING"]}}}},
    "issues": {"type": "array"},
    "academic_review": {"const": "PENDING"},
    "grading_support": {"const": "NOT_ASSESSED"},
    "publishable": {"const": false}
  },
  "$defs": {
    "part": {"type": "object", "required": ["markdown", "choices", "source_spans", "raw_text_lossy", "fragments"], "properties": {"markdown": {"type": "string"}, "raw_text_lossy": {"type": ["string", "null"]}, "source_spans": {"type": "array"}, "fragments": {"type": "array"}, "choices": {"type": "array", "items": {"type": "object", "required": ["label", "markdown"], "properties": {"label": {"enum": ["A", "B", "C", "D"]}, "markdown": {"type": "string"}}, "additionalProperties": false}}}}
  }
}
