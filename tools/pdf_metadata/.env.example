# Local Gemini API configuration. Copy to .env; the secret .env is ignored by Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
PDF_REVIEW_PROVIDER=local
LOCAL_REVIEW_MODEL=qwen3-vl-2b-instruct
LOCAL_REVIEW_URL=http://127.0.0.1:8790/v1

# The default review provider is local; no cloud fallback is performed.
# Explicit gemini-* actions / -Provider gemini enable Google API calls.
# Local inference has local token counts, but no provider token bill.
