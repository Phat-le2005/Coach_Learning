API_BASE_URL=http://127.0.0.1:8000

# Live ink: browser-reachable backend WS origin, without path/query/credentials.
# Dev default derives backend port and browser hostname. Production: configure WSS.
MATH_INK_WS_ORIGIN=
# Optional LAN/HTTPS frontend origin used by pairing QR (never a bearer token).
NEXT_PUBLIC_APP_URL=

# Optional local PP-DocLayout-M. Leave BOTH blank for Geometry + browser CoMER.
# Only server-configured HTTP loopback addresses accepted; never expose this token to NEXT_PUBLIC_*.
OCR_LAYOUT_SERVICE_URL=
OCR_LAYOUT_SERVICE_TOKEN=

# AUTH_SESSION_SECRET bắt buộc có độ dài tối thiểu 32 ký tự ngẫu nhiên.
# Tuyệt đối không dùng chuỗi rỗng hoặc mặc định thiếu an toàn.
# Lệnh tạo nhanh:
#   Bash: openssl rand -hex 32
#   PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 48 | % {[char]$_})
#   Node.js: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=

# Local development: false (HTTP). Production: true (HTTPS).
SESSION_COOKIE_SECURE=false

# Thời gian sống của refresh token cookie (mặc định 7 ngày = 604800 giây).
AUTH_REFRESH_COOKIE_MAX_AGE_SECONDS=604800
SELF_STUDY_PUBLISHED_SUBJECT_CODES=MATH_G12

# Optional local research routes; development only, signed login required.
OCR_V2_EXPERIMENTAL=0
OCR_V2_SIDECAR_URL=http://127.0.0.1:8031
OCR_V2_SIDECAR_TOKEN=
