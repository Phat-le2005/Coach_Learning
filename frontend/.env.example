API_BASE_URL=http://127.0.0.1:8000

# AUTH_SESSION_SECRET bắt buộc có độ dài tối thiểu 32 ký tự ngẫu nhiên.
# Tuyệt đối không dùng chuỗi rỗng hoặc mặc định thiếu an toàn.
# Lệnh tạo nhanh:
#   Bash: openssl rand -hex 32
#   PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 48 | % {[char]$_})
#   Node.js: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=

# Local development: false (HTTP). Production: true (HTTPS).
SESSION_COOKIE_SECURE=false

# Thời gian sống của refresh token cookie (mặc định 7 ngày = 604800 giây).
AUTH_REFRESH_COOKIE_MAX_AGE_SECONDS=604800
SELF_STUDY_PUBLISHED_SUBJECT_CODES=MATH_G12
