{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [
      {
        "source": "/api/v2/:path*",
        "destination": "http://127.0.0.1:8000/api/v2/:path*",
        "missing": [
          {
            "type": "header",
            "key": "x-edums-bff"
          }
        ],
        "regex": "^/api/v2(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      }
    ],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/v2/math-solutions/attempts/[...path]",
      "regex": "^/api/v2/math\\-solutions/attempts/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPpath": "nxtPpath"
      },
      "namedRegex": "^/api/v2/math\\-solutions/attempts/(?<nxtPpath>.+?)(?:/)?$"
    },
    {
      "page": "/api/v3/math-solutions/attempts/[attemptId]/ai-review",
      "regex": "^/api/v3/math\\-solutions/attempts/([^/]+?)/ai\\-review(?:/)?$",
      "routeKeys": {
        "nxtPattemptId": "nxtPattemptId"
      },
      "namedRegex": "^/api/v3/math\\-solutions/attempts/(?<nxtPattemptId>[^/]+?)/ai\\-review(?:/)?$"
    },
    {
      "page": "/api/v3/math-solutions/attempts/[attemptId]/paper",
      "regex": "^/api/v3/math\\-solutions/attempts/([^/]+?)/paper(?:/)?$",
      "routeKeys": {
        "nxtPattemptId": "nxtPattemptId"
      },
      "namedRegex": "^/api/v3/math\\-solutions/attempts/(?<nxtPattemptId>[^/]+?)/paper(?:/)?$"
    },
    {
      "page": "/api/v3/math-solutions/attempts/[attemptId]/paper/[paperId]",
      "regex": "^/api/v3/math\\-solutions/attempts/([^/]+?)/paper/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPattemptId": "nxtPattemptId",
        "nxtPpaperId": "nxtPpaperId"
      },
      "namedRegex": "^/api/v3/math\\-solutions/attempts/(?<nxtPattemptId>[^/]+?)/paper/(?<nxtPpaperId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/v3/math-solutions/attempts/[attemptId]/paper/[paperId]/ocr",
      "regex": "^/api/v3/math\\-solutions/attempts/([^/]+?)/paper/([^/]+?)/ocr(?:/)?$",
      "routeKeys": {
        "nxtPattemptId": "nxtPattemptId",
        "nxtPpaperId": "nxtPpaperId"
      },
      "namedRegex": "^/api/v3/math\\-solutions/attempts/(?<nxtPattemptId>[^/]+?)/paper/(?<nxtPpaperId>[^/]+?)/ocr(?:/)?$"
    },
    {
      "page": "/student/attempts/[attemptId]",
      "regex": "^/student/attempts/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPattemptId": "nxtPattemptId"
      },
      "namedRegex": "^/student/attempts/(?<nxtPattemptId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/student/practice/solutions/[attemptId]",
      "regex": "^/student/practice/solutions/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPattemptId": "nxtPattemptId"
      },
      "namedRegex": "^/student/practice/solutions/(?<nxtPattemptId>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/account",
      "regex": "^/account(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/account(?:/)?$"
    },
    {
      "page": "/admin",
      "regex": "^/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin(?:/)?$"
    },
    {
      "page": "/auth/csrf",
      "regex": "^/auth/csrf(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/auth/csrf(?:/)?$"
    },
    {
      "page": "/auth/login",
      "regex": "^/auth/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/auth/login(?:/)?$"
    },
    {
      "page": "/auth/logout",
      "regex": "^/auth/logout(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/auth/logout(?:/)?$"
    },
    {
      "page": "/auth/me",
      "regex": "^/auth/me(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/auth/me(?:/)?$"
    },
    {
      "page": "/auth/refresh",
      "regex": "^/auth/refresh(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/auth/refresh(?:/)?$"
    },
    {
      "page": "/icon.svg",
      "regex": "^/icon\\.svg(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/icon\\.svg(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/parent",
      "regex": "^/parent(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/parent(?:/)?$"
    },
    {
      "page": "/student",
      "regex": "^/student(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/student(?:/)?$"
    },
    {
      "page": "/student/attempts",
      "regex": "^/student/attempts(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/student/attempts(?:/)?$"
    },
    {
      "page": "/student/knowledge",
      "regex": "^/student/knowledge(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/student/knowledge(?:/)?$"
    },
    {
      "page": "/teacher",
      "regex": "^/teacher(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/teacher(?:/)?$"
    },
    {
      "page": "/unauthorized",
      "regex": "^/unauthorized(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/unauthorized(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}