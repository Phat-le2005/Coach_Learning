{
  "name": "edums-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname localhost --port 3000",
    "build": "next build",
    "start": "next start --hostname localhost --port 3000",
    "test": "npm run test:compile && node --test .test-build/tests/api-client.test.js .test-build/tests/auth-security.test.js .test-build/tests/auth-ux.test.js .test-build/tests/rbac.test.js .test-build/tests/student-home-adapter.test.js .test-build/tests/action-resolver.test.js .test-build/tests/mastery-contracts.test.js .test-build/tests/knowledge-forest-adapter.test.js .test-build/tests/knowledge-forest-filter.test.js .test-build/tests/living-tree-layout.test.js .test-build/tests/self-study-discovery.test.js .test-build/tests/math-ink-contracts.test.js .test-build/tests/math-ink-geometry.test.js .test-build/tests/math-ocr-sync.test.js .test-build/tests/math-workspace-path.test.js .test-build/tests/ocr-confidence.test.js .test-build/tests/ocr-math-preview.test.js .test-build/tests/ocr-ink.test.js .test-build/tests/math-solver.test.js",
    "test:compile": "tsc -p tsconfig.test.json",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "katex": "^0.18.7",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.0.0"
  }
}
