{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": ".test-build",
    "rootDir": "."
  },
  "include": [
    "src/lib/api/client.ts",
    "src/lib/api/math-workspace-path.ts",
    "src/lib/api/session-refresh.ts",
    "src/lib/api/contracts.ts",
    "src/lib/api/validation.ts",
    "src/lib/auth/constants.ts",
    "src/lib/auth/account-menu-state.ts",
    "src/lib/auth/browser.ts",
    "src/lib/auth/cookie-policy.ts",
    "src/lib/auth/login-validation.ts",
    "src/lib/auth/login-session.ts",
    "src/lib/auth/rbac.ts",
    "src/lib/auth/security.ts",
    "src/lib/auth/session-codec.ts",
    "src/features/student-home/action-resolver.ts",
    "src/features/student-home/adapter.ts",
    "src/features/student-home/copy.ts",
    "src/features/student-home/types.ts",
    "src/features/student-attempts/types.ts",
    "src/features/student-attempts/adapter.ts",
    "src/features/knowledge-forest/types.ts",
    "src/features/knowledge-forest/copy.ts",
