    "src/features/math-workspace/**/*.ts",
    "src/features/math-solver/**/*.ts",
    "src/features/math-canvas/implicit.worker.ts",
    "src/features/math-canvas/scene.worker.ts",
    "src/features/math-canvas/lab.worker.ts",
    "e2e/qa-harness-safety.ts",
    "tests/**/*.ts"
